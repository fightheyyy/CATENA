# syntax=docker/dockerfile:1.7

FROM node:24-alpine AS web-build
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ENV COREPACK_NPM_REGISTRY=$NPM_CONFIG_REGISTRY
RUN corepack enable
WORKDIR /src/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm config set registry "$NPM_CONFIG_REGISTRY" \
  && pnpm install --frozen-lockfile --ignore-workspace
COPY frontend/index.html frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json frontend/vite.config.ts ./
COPY frontend/public ./public
COPY frontend/src ./src
RUN pnpm build

FROM golang:1.25-alpine AS build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend ./
RUN rm -rf internal/control/web
COPY --from=web-build /src/frontend/dist ./internal/control/web
RUN --mount=type=cache,target=/root/.cache/go-build \
  --mount=type=cache,target=/go/pkg/mod \
  CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/catena-server ./cmd/catena-server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/catena-server /usr/local/bin/catena-server
RUN addgroup -S -g 1000 catena \
  && adduser -S -D -H -u 1000 -G catena catena \
  && mkdir -p /var/lib/catena \
  && chown -R catena:catena /var/lib/catena
USER catena
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/catena-server"]
