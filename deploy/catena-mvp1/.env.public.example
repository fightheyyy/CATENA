# Public hostname. A real domain or an IP-backed DNS name such as sslip.io is
# required so Caddy can issue a trusted certificate.
CATENA_DOMAIN=catena.example.com

CATENA_AUTH_PROVIDER=github
CATENA_GITHUB_CLIENT_ID=
CATENA_GITHUB_CLIENT_SECRET=

# Generate independent URL-safe values. Never reuse provider credentials.
CATENA_GATEWAY_SECRET=
CATENA_NEXTAUTH_SECRET=
CATENA_API_TOKEN_SECRET=
CATENA_CREDENTIALS_SECRET=
CATENA_POSTGRES_ADMIN_PASSWORD=
CATENA_CORE_DB_PASSWORD=
CATENA_LANGWATCH_DB_PASSWORD=
CATENA_CLICKHOUSE_PASSWORD=

# Embedded XiaoBaOS Evolution Runtime.
XIAOBA_LLM_PROVIDER=openai
XIAOBA_LLM_API_BASE=https://api.example.com/v1
XIAOBA_LLM_API_KEY=
XIAOBA_LLM_MODEL=
XIAOBA_LLM_MAX_TOKENS=4096

# Optional Conversation-derived memory profile.
# COMPOSE_PROFILES=memory
# CATENA_MEMORY_URL=http://gauzmem:1235
# GAUZ_LLM_API_BASE=https://api.example.com/v1
# GAUZ_LLM_API_KEY=
# GAUZ_LLM_MODEL=
# DASHSCOPE_API_KEY=
# CATENA_GAUZMEM_MYSQL_PASSWORD=
# CATENA_NEO4J_PASSWORD=
# Override only when the GDS jar is preloaded in the neo4j-plugins volume.
# CATENA_NEO4J_PLUGINS='["apoc"]'
