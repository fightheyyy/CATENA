# syntax=docker/dockerfile:1.7

# Production/offline build path. The web bundle must be generated and placed
# in catena-web/dist before building this image.
FROM golang:1.25-alpine AS build
WORKDIR /src/control-plane
COPY control-plane/go.mod control-plane/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY control-plane ./
RUN rm -rf internal/control/web
COPY catena-web/dist ./internal/control/web
RUN --mount=type=cache,target=/root/.cache/go-build \
  --mount=type=cache,target=/go/pkg/mod \
  CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/catena-server ./cmd/barena-server \
  && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/catena-runner-client ./cmd/spiral-runner-client

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/catena-server /usr/local/bin/catena-server
COPY --from=build /out/catena-runner-client /usr/local/bin/catena-runner-client
COPY deploy/catena-mvp1/worker-markers /opt/catena
RUN addgroup -S -g 1000 catena \
  && adduser -S -D -H -u 1000 -G catena catena \
  && mkdir -p /var/lib/catena/runs /var/lib/catena/evolution \
  && chown -R catena:catena /var/lib/catena
USER catena
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/catena-server"]
