# Local four-service deployment. Defaults are loopback-only and not production secrets.
CATENA_APP_PORT=5570
CATENA_POSTGRES_PORT=54329
CATENA_CLICKHOUSE_PORT=8123
CATENA_GATEWAY_SECRET=replace-with-at-least-32-random-characters
CATENA_API_TOKEN_SECRET=replace-with-at-least-32-random-characters
CATENA_ENGINE_TOKEN=replace-with-at-least-32-random-characters
CATENA_POSTGRES_ADMIN_PASSWORD=replace-with-a-random-password
CATENA_CORE_DB_PASSWORD=replace-with-a-random-password
CATENA_CLICKHOUSE_PASSWORD=replace-with-a-random-password
# Set this consistently with CLICKHOUSE_PASSWORD above.
CATENA_CLICKHOUSE_DSN=http://default:replace-with-a-random-password@clickhouse:8123/catena?dial_timeout=5s
# GitHub OAuth for authenticated deployment; no Google provider is implemented.
# CATENA_DOMAIN=catena.example.com
# CATENA_GITHUB_CLIENT_ID=
# CATENA_GITHUB_CLIENT_SECRET=
# CATENA_GITHUB_REDIRECT_URL=http://localhost:5570/api/auth/callback/github
CATENA_CODEX_REASONING_EFFORT=low
CATENA_ENGINE_REQUEST_TIMEOUT=20m
CATENA_JOB_WORKERS=1
CATENA_JOB_TIMEOUT=20m
# Optional RSI overlay, approved existing Harbor Cases and explicit Docker access.
# CATENA_RSI_WORKSPACE=/srv/catena-rsi
# CATENA_DOCKER_GID=998
# Optional OpenViking overlay. Secret is used by Engine, not Go.
# CATENA_OPENVIKING_API_KEY=
# CATENA_OPENVIKING_CONFIG_DIR=../../.local/openviking
