# Optional local overrides. The checked-in defaults bind all public ports to
# loopback and use obvious development-only secrets.
CATENA_APP_PORT=5570
CATENA_RUNNER_PORT=8790
CATENA_POSTGRES_PORT=54329
CATENA_CLICKHOUSE_PORT=8123

# Optional Conversation-derived memory. Enable the three-service memory profile only
# after setting a real OpenAI-compatible LLM endpoint and embedding key:
# COMPOSE_PROFILES=memory
# CATENA_MEMORY_URL=http://gauzmem:1235
# CATENA_MEMORY_API_KEY=
# GAUZ_LLM_API_BASE=http://host.docker.internal:8317/v1
# GAUZ_LLM_API_KEY=xiaoba-local
# GAUZ_LLM_MODEL=gpt-5.6-sol
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# CATENA_GAUZMEM_MYSQL_PASSWORD=replace-with-a-random-password
# CATENA_NEO4J_PASSWORD=replace-with-a-random-password

# Catena-owned Go Trace store.
CATENA_CLICKHOUSE_DSN=http://default:langwatch@clickhouse:8123/langwatch?dial_timeout=5s

# Replace these before exposing Catena beyond localhost.
CATENA_GATEWAY_SECRET=replace-with-at-least-32-random-characters
CATENA_API_TOKEN_SECRET=replace-with-at-least-32-random-characters
CATENA_POSTGRES_ADMIN_PASSWORD=replace-with-a-random-password

# Recommended for a developer-facing Catena deployment. Use this callback for
# the default local port:
# http://localhost:5570/api/auth/callback/github
# CATENA_AUTH_PROVIDER=github
# CATENA_GITHUB_CLIENT_ID=
# CATENA_GITHUB_CLIENT_SECRET=
# CATENA_GITHUB_REDIRECT_URL=http://localhost:5570/api/auth/callback/github

# Google is an alternative provider. Select exactly one provider per
# deployment; do not configure this together with CATENA_AUTH_PROVIDER=github.
# Callback: http://localhost:5570/api/auth/callback/google
# CATENA_AUTH_PROVIDER=google
# CATENA_GOOGLE_CLIENT_ID=
# CATENA_GOOGLE_CLIENT_SECRET=

# Trace Farm model credentials are configured per user in API Management.
# Catena intentionally has no deployment-wide shared LLM.

# Reproducible source pins. Override only while developing those components.
# CATENA_BARENA_CONTEXT=https://github.com/fightheyyy/barena.git#catena-mvp1-engine-20260807
# CATENA_XIAOBA_CONTEXT=https://github.com/fightheyyy/xiaobaOS.git#b4d5af58a0fa171c372a875618c5f46ab15ddb36
# CATENA_GAUZMEM_CONTEXT=https://github.com/fightheyyy/gauzrag.git#27750ccf3611bb4dc9e5bca0e77023a277d677fe
