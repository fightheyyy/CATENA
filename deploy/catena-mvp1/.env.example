# Optional local overrides. The checked-in defaults bind all public ports to
# loopback and use obvious development-only secrets.
CATENA_APP_PORT=5570
CATENA_CORE_PORT=8787
CATENA_RUNNER_PORT=8790
CATENA_POSTGRES_PORT=54329
CATENA_CLICKHOUSE_PORT=8123
CATENA_REDIS_PORT=6379

# Replace these before exposing Catena beyond localhost.
CATENA_GATEWAY_SECRET=replace-with-at-least-32-random-characters
CATENA_NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
CATENA_API_TOKEN_SECRET=replace-with-at-least-32-random-characters
CATENA_CREDENTIALS_SECRET=replace-with-at-least-32-random-characters
CATENA_POSTGRES_ADMIN_PASSWORD=replace-with-a-random-password

# Optional GitHub OAuth. Use this callback for the default local port:
# http://localhost:5570/api/auth/callback/github
# CATENA_AUTH_PROVIDER=github
# CATENA_GITHUB_CLIENT_ID=
# CATENA_GITHUB_CLIENT_SECRET=

# Optional XiaoBaOS evaluator/evolution model. Readiness and Trace viewing do
# not require a model key; Explore/Evolution role turns do.
XIAOBA_LLM_PROVIDER=openai
XIAOBA_LLM_API_BASE=http://host.docker.internal:8317/v1
XIAOBA_LLM_API_KEY=
XIAOBA_LLM_MODEL=gpt-5.6-sol
XIAOBA_LLM_MAX_TOKENS=4096

# Reproducible source pins. Override only while developing those components.
# CATENA_BARENA_CONTEXT=https://github.com/fightheyyy/barena.git#catena-mvp1-engine-20260803
# CATENA_XIAOBA_CONTEXT=https://github.com/fightheyyy/xiaobaOS.git#b4d5af58a0fa171c372a875618c5f46ab15ddb36
