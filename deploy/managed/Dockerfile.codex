FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
RUN apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @openai/codex@0.160.0 \
 && userdel node && useradd -m -u 1000 agent \
 && mkdir -p /workspace /opt/catena && chown agent:agent /workspace
COPY engine/catena_engine/contracts.py engine/catena_engine/protocol.py engine/catena_engine/harness_transport.py /opt/catena/catena_engine/
COPY engine/catena_engine/runtime/codex.py /opt/catena/catena_engine/runtime/
COPY engine/catena_engine/skills/ /opt/catena/catena_engine/skills/
COPY engine/catena_engine/managed/entry.py /opt/catena/catena_engine/managed/
COPY engine/catena_engine/managed/foreground.py /opt/catena/foreground.py
# execd starts as root; each user command is explicitly launched as uid/gid 1000.
WORKDIR /workspace
