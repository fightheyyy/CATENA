# syntax=docker/dockerfile:1.7

# Catena reuses the pinned LangWatch runtime image while rebuilding the
# downstream Web client from this checkout. A fresh clone therefore does not
# need a pre-generated langwatch/dist directory on the host.
FROM langwatch/langwatch:3.7.0

WORKDIR /app

# Copy the complete current workspace surface used by the Vite client. The
# pinned runtime image can have older workspace contracts; copying only src/
# would compile current UI code against stale package exports.
COPY langwatch ./langwatch
COPY packages/handled-error ./packages/handled-error
COPY packages/langy ./packages/langy
COPY mcp-server ./mcp-server

RUN cd langwatch \
  && CI=true pnpm install --frozen-lockfile --prod=false \
  && NODE_ENV=production BUILD_TIME=1 SKIP_ENV_VALIDATION=true pnpm run build:client \
  && pnpm prisma generate

WORKDIR /app/langwatch
CMD ["bash", "scripts/start-catena-compose.sh"]
