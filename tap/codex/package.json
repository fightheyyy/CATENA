{
  "name": "@catena/codex-runtime-parser",
  "version": "0.2.0",
  "private": true,
  "description": "Langfuse-derived Codex rollout parser with Catena Canonical Event Graph and OTLP export",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
