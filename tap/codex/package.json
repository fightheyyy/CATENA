  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.18.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.24.0"
}
